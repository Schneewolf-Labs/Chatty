  "bugs": {
    "url": "https://github.com/Schneewolf-Labs/Chatty/issues"
  },
  "homepage": "https://github.com/Schneewolf-Labs/Chatty#readme",
  "dependencies": {
    "bad-words": "^3.0.4",
    "discord.js": "^14.13.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fast-levenshtein": "^3.0.0",
    "pino": "^8.15.1",
    "pino-pretty": "^10.2.0",
    "sentiment": "^5.0.2",
    "speaker": "^0.5.4",
    "tmi.js": "^1.8.5",
    "ws": "^8.14.2",
    "yaml": "^2.3.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
